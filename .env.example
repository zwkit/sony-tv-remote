# 复制成 .env（已被 .gitignore 忽略）后改成你自己的值，或直接当环境变量传给 node / docker compose。
# 仓库默认值均为空或示例，不含任何真实密钥；切勿把真实令牌写进仓库。

# ── 电视连接 ─────────────────────────────────────────────
# 电视的 adb 地址。示例值，务必改成你电视的 IP；连不上会自动扫网段找回。
TV_ADB=192.168.1.50:5555
# adb 可执行文件（留空则自动探测：PATH / C:\adb\adb.exe / Android SDK 等）
ADB_PATH=
# 自动发现电视（扫 5555 端口，只认 characteristics 含 tv 的真电视）。
# 局域网有开着远程 ADB 的模拟器（雷电/MuMu/夜神）时建议设 0。
DISCOVER=1
# 扫描网段，留空=自动（取本机网段）；桥接网络/跨网段时手动填，如 192.168.1.
LAN_SUBNET=

# ── 服务端口 ─────────────────────────────────────────────
# HTTP：遥控页面 + API
PORT=8787
# HTTPS：同一份服务，实时预览必须走这个（WebCodecs 只在安全上下文可用）。
# 设 0 关闭：此时预览只在 localhost 下有效，或靠反向代理提供的 https。
HTTPS_PORT=8788
# 数据目录：证书、图标缓存、状态、原输入法记录（Docker 里挂卷持久化）
DATA_DIR=./data

# ── 鉴权（务必看）────────────────────────────────────────
# 留空 = 不鉴权。暴露到公网 / VPN 前务必设一个随机长令牌，
# 访问时带 ?t=你的令牌 或请求头 x-token。不要直接把端口暴露到公网。
AUTH_TOKEN=
# 电视端推流 App（vendor/tvcast.apk）通道端口，0 = 关闭；不装 App 不受影响。
CAST_PORT=8790
# 推流通道令牌，留空则回退到 AUTH_TOKEN。
CAST_TOKEN=

# ── 索尼 IP 控制（可选，关掉 ADB 也能按键遥控）──────────
# 电视：设置 → 网络和互联网 → 家庭网络设置 → IP 控制 → 认证选「普通和预共享密钥」
SONY_HOST=
SONY_PSK=
# 个别固件键名对不上时重映射：键是 Android 键码，值是电视报的 IRCC 名
# IRCC_KEYS={"66":"Enter","219":"Assists"}

# ── 实时预览 ─────────────────────────────────────────────
# 宽高必须都是 16 的倍数：854x480 会补绿条，848x480 才干净
PREVIEW_SIZE=848x480
PREVIEW_BITRATE=2500000
# 这台索尼把全范围(0~255)画面标成 limited 导致暗部压黑，默认自动纠正；
# 换到标得正确的电视时设 limited 关掉纠正。
PREVIEW_RANGE=auto

# ── 语音 / 搜片（可选）──────────────────────────────────
# 手机浏览器自带语音识别优先，不可用时才用下面的兼容 OpenAI 的 Whisper 接口
SEARCH_ACTION=com.dangbei.intent.search
ASR_URL=
ASR_KEY=
ASR_MODEL=whisper-1

# ── 容器 ────────────────────────────────────────────────
TZ=Asia/Shanghai
